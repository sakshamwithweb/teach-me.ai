{
    "manifest_version": 3,
    "name": "Test Ext",
    "description": "Just for test bro",
    "version": "1.0",
    "permissions":["tabs"],
    "host_permissions":["https://*.youtube.com/*"],
    "background":{
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://*.youtube.com/*"],
            "js": ["content.js"]
        }
    ]
}